{
  "name": "inplain.ai",
  "version": "2.0.0",
  "private": true,
  "description": "AI-powered privacy policy monitoring and analysis",
  "homepage": "https://inplain.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/inplain-ai/inplain.ai.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.2.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "e2e": "turbo run e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "node -e \"if (process.env.CI !== 'true' && process.env.VERCEL !== '1') { require('child_process').execSync('husky install', { stdio: 'inherit' }); }\""
  },
  "devDependencies": {
    "@turbo/gen": "^1.13.0",
    "@types/jspdf": "^2.0.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^8.0.3",
    "prettier": "^3.3.0",
    "turbo": "^1.13.0",
    "typescript": "^5.5.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@types/react": "^18.3.3"
  },
  "dependencies": {
    "@json2csv/plainjs": "^7.0.6",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@types/diff": "^7.0.2",
    "diff": "^8.0.2",
    "jose": "^6.0.11",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "jszip": "^3.10.1",
    "redis": "^5.5.6",
    "resend": "^4.7.0"
  }
}
