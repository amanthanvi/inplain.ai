# Dependencies
node_modules/
.venv/
__pycache__/

# Build
dist/
_site/
._site.tmp/
*.egg-info/
# schema.dump_record's temp file, if a run is killed mid-write
changes/*.tmp

# Environment
# .env.example files are tracked on purpose; nothing else is.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# IDE / OS
.vscode/
.idea/
.DS_Store

# Cache
.ruff_cache/
.pytest_cache/

# Prototype build output and raw screenshots (prototypes/screenshots/*.webp are tracked)
prototypes/out/
prototypes/shots/
