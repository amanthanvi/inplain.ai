{
  "framework": "nextjs",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/monitor",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/api/cron/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/cron/monitor": {
      "includeFiles": "**"
    }
  }
}