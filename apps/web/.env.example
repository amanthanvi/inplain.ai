# Clerk (required once auth is wired)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Billing plan keys (optional defaults)
# These should match the plan identifiers configured in Clerk Billing.
CLERK_PLAN_PRO=user:pro
CLERK_PLAN_BUSINESS=user:business

# Web -> API (internal) service token
INTERNAL_SERVICE_TOKEN=dev-internal-token

# In dev, the internal API might be on localhost
INTERNAL_API_BASE_URL=http://localhost:8000
