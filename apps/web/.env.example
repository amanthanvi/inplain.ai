# Clerk (required once auth is wired)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Billing plan keys (optional defaults)
# These should match the plan identifiers configured in Clerk Billing.
CLERK_PLAN_FREE=free_user
CLERK_PLAN_PRO=inplain_pro
CLERK_PLAN_BUSINESS=inplain_business
CLERK_BILLING_WEBHOOK_SECRET=

# Web -> API (internal) service token
INTERNAL_SERVICE_TOKEN=dev-internal-token

# In dev, the internal API might be on localhost
INTERNAL_API_BASE_URL=http://localhost:8000

# Product analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
