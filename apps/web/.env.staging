# Staging Environment Configuration
# This file should be used for staging deployments

# App Configuration
NEXT_PUBLIC_APP_URL=https://staging.inplain.ai
NEXT_PUBLIC_ENVIRONMENT=staging

# Clerk Auth (Staging)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Vercel KV (Staging Database)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Vercel Blob (Staging Storage)
BLOB_READ_WRITE_TOKEN=

# OpenRouter AI (Use lower rate limits for staging)
OPENROUTER_API_KEY=

# Sentry (Staging)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_ANALYSIS=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_PWA=true

# Rate Limiting (More restrictive for staging)
RATE_LIMIT_AI_PER_MINUTE=30
RATE_LIMIT_SEARCH_PER_MINUTE=60

# Monitoring
HEALTH_CHECK_TOKEN=
MONITORING_ENABLED=true

# Cron Jobs
CRON_SECRET=

# Debug
DEBUG_MODE=true
LOG_LEVEL=debug