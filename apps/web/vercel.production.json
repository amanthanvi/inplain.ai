{
  "name": "inplain",
  "alias": ["inplain.ai", "www.inplain.ai"],
  "env": {
    "NEXT_PUBLIC_ENVIRONMENT": "production",
    "DEBUG_MODE": "false",
    "LOG_LEVEL": "error"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_APP_URL": "https://inplain.ai",
      "NEXT_PUBLIC_ENVIRONMENT": "production",
      "SENTRY_ENVIRONMENT": "production"
    }
  },
  "functions": {
    "src/app/api/privacy/analyze-advanced/route.ts": {
      "maxDuration": 60,
      "memory": 3008
    },
    "src/app/api/scrape/route.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "src/app/api/export/route.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Environment",
          "value": "production"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.inplain.ai"
        }
      ],
      "destination": "https://inplain.ai",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-policies",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/update-scores",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 3 * * 0"
    },
    {
      "path": "/api/cron/generate-reports",
      "schedule": "0 0 1 * *"
    }
  ],
  "regions": ["iad1", "sfo1"],
  "analyticsId": "inplain"
}