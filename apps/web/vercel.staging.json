{
  "name": "inplain-staging",
  "alias": ["staging.inplain.ai"],
  "env": {
    "NEXT_PUBLIC_ENVIRONMENT": "staging",
    "DEBUG_MODE": "true",
    "LOG_LEVEL": "debug"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_APP_URL": "https://staging.inplain.ai",
      "NEXT_PUBLIC_ENVIRONMENT": "staging",
      "SENTRY_ENVIRONMENT": "staging"
    }
  },
  "functions": {
    "src/app/api/privacy/analyze-advanced/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/scrape/route.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Environment",
          "value": "staging"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.staging.inplain.ai"
        }
      ],
      "destination": "https://staging.inplain.ai",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-policies",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/update-scores",
      "schedule": "0 2 * * *"
    }
  ]
}