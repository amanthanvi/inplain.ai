# OpenRouter AI API
OPENROUTER_API_KEY=sk-or-v1-your-key-here
DEFAULT_AI_MODEL=google/gemini-2.5-flash-preview-05-20

# Vercel Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token-here
KV_REST_API_URL=https://your-kv-rest-api-url.upstash.io
KV_REST_API_TOKEN=your-kv-token-here

# Cron Security
CRON_SECRET=your-super-secret-cron-key

# Development
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Redis (Development)
REDIS_URL=redis://localhost:6379

# Blob Storage (Development)
BLOB_STORAGE_URL=http://localhost:4566
BLOB_STORAGE_TOKEN=

# Logging
LOG_LEVEL=info

# AI Service Configuration
AI_CACHE_EXPIRY_HOURS=24
AI_RATE_LIMIT_PER_MINUTE=60
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.3
