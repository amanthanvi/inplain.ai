# Copy to .env.local and fill in. Never commit a filled-in copy.

# --- Authentication (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
CLERK_SECRET_KEY=sk_test_your-key-here

# --- Storage (Vercel KV / Upstash Redis) ---
KV_REST_API_URL=https://your-kv-rest-api-url.upstash.io
KV_REST_API_TOKEN=your-kv-token-here

# --- Storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token-here

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-v1-your-key-here
DEFAULT_AI_MODEL=google/gemini-2.5-flash-preview-05-20
AI_CACHE_EXPIRY_HOURS=24
AI_RATE_LIMIT_PER_MINUTE=60
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.3

# --- Cron ---
# Shared secret the scheduled monitor endpoint checks before running.
CRON_SECRET=your-super-secret-cron-key

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api
LOG_LEVEL=info
