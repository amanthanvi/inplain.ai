# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Vercel Storage
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token-here
KV_REST_API_URL=https://your-kv-rest-api-url.upstash.io
KV_REST_API_TOKEN=your-kv-token-here

# Cron Security
CRON_SECRET=your-super-secret-cron-key

# Development
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Redis (Development)
REDIS_URL=redis://localhost:6379

# Blob Storage (Development)
BLOB_STORAGE_URL=http://localhost:4566
BLOB_STORAGE_TOKEN=

# Logging
LOG_LEVEL=info
