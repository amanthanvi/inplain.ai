# Production Environment Variables for Vercel
# Copy these to your Vercel project settings

# Required: OpenRouter AI API
OPENROUTER_API_KEY=
DEFAULT_AI_MODEL=google/gemini-2.0-flash-exp:free

# Required: Vercel KV Storage (auto-configured when you create KV database)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Required: Cron Security
CRON_SECRET=

# Optional: Custom API URL (defaults to production URL)
# NEXT_PUBLIC_API_URL=https://your-app.vercel.app/api

# Optional: Performance Monitoring
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Optional: Error Tracking
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Optional: Email Service (for alerts)
# RESEND_API_KEY=
# EMAIL_FROM=noreply@inplain.ai

# Optional: CDN Configuration
# CDN_URL=https://cdn.inplain.ai

# Runtime Configuration
NODE_ENV=production
AI_CACHE_EXPIRY_HOURS=24
AI_RATE_LIMIT_PER_MINUTE=60
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.3